{
  "name": "processcraft-poc",
  "version": "1.09-sirius",
  "description": "AI-Powered UX Design Workflow Platform",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"cd frontend && npm run dev\" \"cd backend && npm run dev\"",
